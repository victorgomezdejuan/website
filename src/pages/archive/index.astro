---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('archive')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = `Archivo — ${SITE_TITLE}`;
const pageDescription =
	'Artículos técnicos publicados en mi web anterior. Los dejo aquí, tal cual se escribieron en su momento, por si le sirven a alguien.';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 960px;
			}
			.intro {
				max-width: 700px;
				margin: 0 auto 2.5em;
				text-align: center;
				color: rgb(var(--gray));
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5em 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li a {
				display: block;
				padding: 1em 1.2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li a:hover {
				border-color: var(--accent);
				box-shadow: var(--box-shadow);
			}
			.title {
				margin: 0 0 0.35em;
				color: rgb(var(--black));
				line-height: 1.3;
				transition: color 0.15s ease;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			ul li a:hover h4 {
				color: rgb(var(--accent));
			}
			@media (max-width: 720px) {
				ul li {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="intro">
				Antes de este blog tuve otra web personal. Aquí dejo los artículos técnicos que publiqué
				allí, tal cual se escribieron en su momento, por si le resultan útiles a alguien.
			</p>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/archive/${post.id}/`}>
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
