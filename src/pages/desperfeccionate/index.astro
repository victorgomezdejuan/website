---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('desperfeccionate')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = `Desperfecciónate — ${SITE_TITLE}`;
const pageDescription =
	'Artículos de desarrollo personal, filosofía y espiritualidad publicados en Desperfecciónate, mi web anterior. Los dejo aquí, tal cual se escribieron en su momento, por si le sirven a alguien.';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 960px;
			}
			.intro {
				max-width: 700px;
				margin: 0 auto 2.5em;
				text-align: center;
				color: rgb(var(--gray));
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				width: 100%;
				height: 220px;
				object-fit: cover;
				margin-bottom: 0.75rem;
				border-radius: 14px;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.25;
				transition: color 0.15s ease;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				transform: translateY(-3px);
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="intro">
				Antes de este blog tuve otra web, Desperfecciónate, sobre desarrollo personal, filosofía y
				espiritualidad. Aquí dejo los artículos que publiqué allí, tal cual se escribieron en su
				momento, por si le resultan útiles a alguien.
			</p>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/desperfeccionate/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={480} height={240} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
